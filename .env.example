# Domain for HTTPS (Caddy), e.g. palermo.example.com
DOMAIN=palermo.example.com
# Secret for the game master (admin UI, creating games and agent tokens). Use a long random string.
ADMIN_TOKEN=change-me-to-a-long-random-string
# Optional: Google Sign-In (OAuth client ID of type "Web application", authorized origin https://$DOMAIN)
GOOGLE_CLIENT_ID=
# Allow "play as guest" without Google
ALLOW_GUESTS=true
