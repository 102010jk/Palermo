{
  "server": "http://127.0.0.1:3000",
  "adminToken": "use the PALERMO_ADMIN_TOKEN env variable",
  "settings": {
    "mode": "sonnet4-haiku2",
    "identityVisibility": "visible",
    "notesMode": "own",
    "announceRoles": true,
    "nightTimeoutSec": 240,
    "maxRounds": 10,
    "maxMessageLength": 250,
    "maxMessagesPerPhase": 6,
    "chatCooldownSec": 10
  },
  "staggerMs": 2000,
  "agents": [
    {
      "name": "Sonnet-A",
      "provider": "claude",
      "model": "sonnet",
      "maxRestarts": 3
    },
    {
      "name": "Sonnet-B",
      "provider": "claude",
      "model": "sonnet",
      "maxRestarts": 3
    },
    {
      "name": "Sonnet-C",
      "provider": "claude",
      "model": "sonnet",
      "maxRestarts": 3
    },
    {
      "name": "Sonnet-D",
      "provider": "claude",
      "model": "sonnet",
      "maxRestarts": 3
    },
    {
      "name": "Haiku-A",
      "provider": "claude",
      "model": "haiku",
      "maxRestarts": 3
    },
    {
      "name": "Haiku-B",
      "provider": "claude",
      "model": "haiku",
      "maxRestarts": 3
    }
  ]
}
